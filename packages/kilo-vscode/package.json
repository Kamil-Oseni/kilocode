{
  "// raya_change": "Raya extension identity and namespace",
  "name": "raya",
  "displayName": "Raya",
  "description": "Raya is Eden's private agentic coding IDE, with chat, autocomplete, tool use, and support for 500+ AI models.",
  "version": "7.4.23",
  "icon": "assets/icons/eden-logo-256.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "eden",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamil-Oseni/kilocode.git",
    "directory": "packages/kilo-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Eden"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "raya",
    "Eden",
    "agentic IDE",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "opencode",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.kilo/worktrees/**": true,
        "**/.kilocode/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "raya-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "raya-logo": {
        "description": "Raya logo",
        "default": {
          "fontPath": "assets/icons/kilo-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "raya-ActivityBar",
          "title": "Raya",
          "icon": "assets/icons/eden-logo-light.svg",
          "darkIcon": "assets/icons/eden-logo-dark.svg"
        }
      ]
    },
    "views": {
      "raya-ActivityBar": [
        {
          "type": "webview",
          "id": "raya.SidebarProvider",
          "name": "Raya"
        }
      ]
    },
    "commands": [
      {
        "command": "raya.plusButtonClicked",
        "title": "New Task",
        "category": "Raya",
        "icon": "$(add)"
      },
      {
        "command": "raya.agentManagerOpen",
        "title": "Agent Manager",
        "category": "Raya",
        "icon": "$(organization)"
      },
      {
        "command": "raya.openBrowser",
        "title": "Open Browser",
        "category": "Raya",
        "icon": "$(globe)"
      },
      {
        "command": "raya.kiloClawOpen",
        "title": "KiloClaw",
        "category": "Raya",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "raya.marketplaceButtonClicked",
        "title": "Marketplace",
        "category": "Raya",
        "icon": "$(extensions)"
      },
      {
        "command": "raya.historyButtonClicked",
        "title": "History",
        "category": "Raya",
        "icon": "$(history)"
      },
      {
        "command": "raya.profileButtonClicked",
        "title": "Profile",
        "category": "Raya",
        "icon": "$(account)"
      },
      {
        "command": "raya.settingsButtonClicked",
        "title": "Settings",
        "category": "Raya",
        "icon": "$(settings-gear)"
      },
      {
        "command": "raya.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "raya.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "raya.sidebarTitle.kiloClawOpen",
        "title": "KiloClaw",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "raya.sidebarTitle.marketplaceButtonClicked",
        "title": "Marketplace",
        "icon": "$(extensions)"
      },
      {
        "command": "raya.sidebarTitle.historyButtonClicked",
        "title": "History",
        "icon": "$(history)"
      },
      {
        "command": "raya.sidebarTitle.profileButtonClicked",
        "title": "Profile",
        "icon": "$(account)"
      },
      {
        "command": "raya.sidebarTitle.settingsButtonClicked",
        "title": "Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "raya.openInTab",
        "title": "Open in Tab",
        "category": "Raya",
        "icon": {
          "light": "assets/icons/eden-logo-light.svg",
          "dark": "assets/icons/eden-logo-dark.svg"
        }
