      },
      {
        "command": "raya.showMemory",
        "title": "Show Project Memory",
        "category": "Raya"
      },
      {
        "command": "raya.toggleMemory",
        "title": "Toggle Project Memory",
        "category": "Raya"
      },
      {
        "command": "raya.autocomplete.generateSuggestions",
        "title": "Generate Suggested Edits",
        "category": "Raya"
      },
      {
        "command": "raya.autocomplete.cancelSuggestions",
        "title": "Cancel Suggested Edits",
        "category": "Raya"
      },
      {
        "command": "raya.autocomplete.nextEdit.acceptOrJump",
        "title": "Next Edit: Accept or Jump to Suggested Edit",
        "category": "Raya"
      },
      {
        "command": "raya.autocomplete.nextEdit.dismiss",
        "title": "Next Edit: Dismiss Pending Suggestion",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.previousSession",
        "title": "Agent Manager: Previous Session",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.nextSession",
        "title": "Agent Manager: Next Session",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.previousTab",
        "title": "Agent Manager: Previous Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.nextTab",
        "title": "Agent Manager: Next Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.previousTerminal",
        "title": "Agent Manager: Previous Terminal",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.nextTerminal",
        "title": "Agent Manager: Next Terminal",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Raya",
        "icon": "$(terminal)"
      },
      {
        "command": "raya.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Raya",
        "icon": "$(play)"
      },
      {
        "command": "raya.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "Raya",
        "icon": "$(diff)"
      },
      {
        "command": "raya.agentManager.showShortcuts",
        "title": "Agent Manager: Show Keyboard Shortcuts",
        "category": "Raya",
        "icon": "$(keyboard)"
      },
      {
        "command": "raya.agentManager.newTab",
        "title": "Agent Manager: New Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.newTerminalTab",
        "title": "Agent Manager: New Terminal Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.newSideTerminal",
        "title": "Agent Manager: New Sidebar Terminal Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.closeTab",
        "title": "Agent Manager: Close Tab",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.newWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.quickWorktree",
        "title": "Agent Manager: New Worktree",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.openWorktree",
        "title": "Agent Manager: Open Worktree",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.openPR",
        "title": "Agent Manager: Open Pull Request",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.closeWorktree",
        "title": "Agent Manager: Close Worktree",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.advancedWorktree",
        "title": "Agent Manager: Configure New Worktree",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo1",
        "title": "Agent Manager: Jump to Item 1",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo2",
        "title": "Agent Manager: Jump to Item 2",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo3",
        "title": "Agent Manager: Jump to Item 3",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo4",
        "title": "Agent Manager: Jump to Item 4",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo5",
        "title": "Agent Manager: Jump to Item 5",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo6",
        "title": "Agent Manager: Jump to Item 6",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo7",
        "title": "Agent Manager: Jump to Item 7",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo8",
        "title": "Agent Manager: Jump to Item 8",
        "category": "Raya"
      },
      {
        "command": "raya.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "Raya"
      },
      {
        "command": "raya.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Raya",
        "icon": {
          "light": "assets/icons/eden-logo-light.svg",
          "dark": "assets/icons/eden-logo-dark.svg"
        }
      },
      {
        "command": "raya.explainCode",
        "title": "Explain Code",
        "category": "Raya"
      },
      {
        "command": "raya.fixCode",
        "title": "Fix Code",
        "category": "Raya"
      },
      {
        "command": "raya.improveCode",
        "title": "Improve Code",
        "category": "Raya"
      },
      {
        "command": "raya.addToContext",
        "title": "Add to Context",
        "category": "Raya"
      },
      {
        "command": "raya.terminalAddToContext",
        "title": "Add Terminal Content to Context",
        "category": "Raya"
      },
      {
        "command": "raya.terminalFixCommand",
        "title": "Fix This Command",
        "category": "Raya"
      },
      {
        "command": "raya.terminalExplainCommand",
        "title": "Explain This Command",
        "category": "Raya"
      },
      {
        "command": "raya.focusChatInput",
        "title": "Focus Chat Input",
        "category": "Raya"
      },
      {
        "command": "raya.toggleChatSearch",
        "title": "Toggle Chat Search",
        "category": "Raya"
      },
      {
        "command": "raya.cycleAgentMode",
        "title": "Cycle Agent Mode",
        "category": "Raya"
      },
      {
        "command": "raya.cyclePreviousAgentMode",
        "title": "Cycle Previous Agent Mode",
        "category": "Raya"
      },
      {
        "command": "raya.toggleAutoApprove",
        "title": "Toggle Auto-Approve",
        "category": "Raya"
      },
      {
        "command": "raya.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "Raya"
      },
      {
        "command": "raya.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
        "category": "Raya"
      },
      {
        "command": "raya.reload",
        "title": "Reload Config and Skills",
        "category": "Raya"
      }
    ],
    "submenus": [
      {
        "id": "raya.editorContextMenu",
        "label": "Raya"
      },
      {
        "id": "raya.terminalContextMenu",
        "label": "Raya"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "raya.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.kiloClawOpen",
          "when": "false"
        },
        {
          "command": "raya.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "raya.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "raya.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.kiloClawOpen",
          "group": "navigation@3",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@4",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.profileButtonClicked",
          "group": "navigation@5",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        },
        {
          "command": "raya.sidebarTitle.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == raya.SidebarProvider && !raya.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "raya.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "raya.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "raya.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "raya.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == raya.TabPanel && !raya.isCursor"
        },
        {
          "command": "raya.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == raya.TabPanel && !raya.isCursor"
        },
        {
          "command": "raya.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == raya.TabPanel && !raya.isCursor"
        },
        {
          "command": "raya.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == raya.TabPanel && !raya.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "raya.editorContextMenu",
          "group": "1_kilocode"
        }
      ],
      "raya.editorContextMenu": [
        {
          "command": "raya.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "raya.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "raya.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "raya.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "raya.terminalContextMenu",
          "group": "2_kilocode"
        }
      ],
      "raya.terminalContextMenu": [
        {
          "command": "raya.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "raya.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "raya.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "raya.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "-workbench.action.tasks.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "raya.openBrowser",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b"
      },
      {
        "command": "raya.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "raya.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "raya.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "raya.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "raya.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "raya.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && !raya.sidebarFocused"
      },
      {
        "command": "raya.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "raya.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && !raya.agentManagerSideTerminalFocused"
      },
      {
        "command": "raya.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && !raya.agentManagerSideTerminalFocused"
      },
      {
        "command": "raya.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel' && raya.agentManagerSideTerminalFocused"
      },
      {
        "command": "raya.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'raya.AgentManagerPanel'"
      },
      {
        "command": "raya.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "raya.sidebarFocused || activeWebviewPanelId == 'raya.AgentManagerPanel' || activeWebviewPanelId == 'raya.TabPanel'"
      },
      {
        "command": "raya.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "raya.sidebarFocused || activeWebviewPanelId == 'raya.AgentManagerPanel' || activeWebviewPanelId == 'raya.TabPanel'"
      },
      {
        "command": "raya.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && raya.autocomplete.hasSuggestions"
      },
      {
        "command": "raya.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && raya.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "raya.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && raya.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "raya.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && kilo-code.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "raya.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && kilo-code.nextEdit.hasPendingSuggestion"
      }
    ],
